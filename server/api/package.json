{
  "name": "@zungo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo 'build skipped — tsx runs source directly'",
    "start": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/runSeed.ts",
    "db:import-words": "tsx src/db/importWordBank.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.29.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@sentry/node": "^10.75.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@zungo/core": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^4.28.0",
    "fastify-type-provider-zod": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.1.0",
    "postgres": "^3.4.4",
    "tsx": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
