# ── Server (server/api/.env) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://...          # Neon connection string (pooled)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.german-app.com
ANTHROPIC_API_KEY=sk-ant-...
SENTRY_DSN=https://...@sentry.io/...
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://eu.i.posthog.com
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Web (apps/web/.env) ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=...
VITE_AUTH0_AUDIENCE=https://api.german-app.com
VITE_SENTRY_DSN=https://...@sentry.io/...
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Mobile (apps/mobile/.env) ─────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=...
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.german-app.com
