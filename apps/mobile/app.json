{
  "expo": {
    "name": "Zungo",
    "slug": "zungo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zungo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C6B6B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zungo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C6B6B"
      },
      "package": "com.zungo.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0C6B6B"
        }
      ]
    ]
  }
}
